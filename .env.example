# =============================================================================
# FINTECH SKILLED AGENTS - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================================================
# LLM PROVIDERS
# =============================================================================

# OpenRouter API Key (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace Token (for Novita via HuggingFace router)
# Get from: https://huggingface.co/settings/tokens
# Used with router.huggingface.co to access Novita models
# See: https://huggingface.co/docs/inference-providers/providers/novita
HUGGINGFACE_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# DEFAULT MODEL SETTINGS
# =============================================================================

# Default provider: "openrouter" or "huggingface_novita"
DEFAULT_LLM_PROVIDER=openrouter

# Default model (must be available in the selected provider)
DEFAULT_LLM_MODEL=google/gemini-2.0-flash-exp:free

# Default temperature (0.0 - 1.0)
DEFAULT_TEMPERATURE=0.3

# Default max tokens
DEFAULT_MAX_TOKENS=4096

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================

# Application environment: development, staging, production
APP_ENV=development

# Enable debug mode (verbose logging)
DEBUG=true

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# =============================================================================
# DATA SETTINGS
# =============================================================================

# Path to synthetic data output
DATA_OUTPUT_PATH=data/synthetic/output

# Number of records to generate
SYNTHETIC_CUSTOMERS=1000
SYNTHETIC_TRANSACTIONS=100000
SYNTHETIC_ALERTS=200

# =============================================================================
# UI SETTINGS
# =============================================================================

# Gradio server settings
GRADIO_SERVER_NAME=0.0.0.0
GRADIO_SERVER_PORT=7860

# Enable sharing (creates public URL)
GRADIO_SHARE=false

# =============================================================================
# SECURITY (for production)
# =============================================================================

# Secret key for session management
SECRET_KEY=your-secret-key-change-in-production

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:7860,http://127.0.0.1:7860
